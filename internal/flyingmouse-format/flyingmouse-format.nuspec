<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>flyingmouse-format</id>
    <version>0.0.0</version>
    <title>FlyingMouse Format</title>
    <authors>LaoFeng-mouse</authors>
    <owners>IT Operations</owners>
    <projectUrl>https://github.com/LaoFeng-mouse/flyingmouse-format/releases</projectUrl>
    <packageSourceUrl>https://github.com/patsaindon/chocolatey-packages/tree/main/internal/flyingmouse-format</packageSourceUrl>
    <description>FlyingMouse Format is a free, offline Windows file converter that transforms between image, document, spreadsheet, presentation, PDF, audio, and video formats using bundled tools like FFmpeg and LibreOffice, with OCR and batch conversion support.</description>
    <tags>internal laofeng-mouse</tags>
    <dependencies />
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
