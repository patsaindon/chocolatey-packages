<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>angryipscanner</id>
    <version>0.0.0</version>
    <title>Angry IP Scanner</title>
    <authors>angryziber (Anton Keks)</authors>
    <owners>IT Operations</owners>
    <projectUrl>https://angryip.org/download/</projectUrl>
    <packageSourceUrl>https://github.com/patsaindon/chocolatey-packages/tree/main/internal/angryipscanner</packageSourceUrl>
    <description>Angry IP Scanner is a fast, open-source, cross-platform network scanner that pings a range of IP addresses and reports which hosts are alive, along with hostname, MAC address, and open ports.</description>
    <tags>internal angryziber-anton-keks</tags>
    <dependencies />
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
