<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>vdhcoapp</id>
    <version>0.0.0</version>
    <title>ACLAP Video DownloadHelper CoApp</title>
    <authors>ACLAP (Video DownloadHelper)</authors>
    <owners>IT Operations</owners>
    <projectUrl>https://github.com/aclap-dev/vdhcoapp/releases</projectUrl>
    <packageSourceUrl>https://github.com/patsaindon/chocolatey-packages/tree/main/internal/vdhcoapp</packageSourceUrl>
    <description>Surfaced by the version-mismatch triage of prospecting/community-version-reference.csv. Renamed from the originally-scaffolded package id 'coapp' to 'vdhcoapp' on human review: Community's existing "coapp" package id is an unrelated, unmaintained package for CoApp.Tools.Powershell (coapp.org) -- not this software -- and reusing that id here would collide if Community's real 'coapp' package is ever internalized onto the same feed. This internal package tracks the vendor's own GitHub releases (aclap-dev/vdhcoapp) directly.</description>
    <tags>internal aclap-video-downloadhelper</tags>
    <dependencies />
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
