<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>coapp</id>
    <version>0.0.0</version>
    <title>ACLAP Video DownloadHelper CoApp</title>
    <authors>ACLAP (Video DownloadHelper)</authors>
    <owners>IT Operations</owners>
    <projectUrl>https://github.com/aclap-dev/vdhcoapp/releases</projectUrl>
    <packageSourceUrl>https://github.com/patsaindon/chocolatey-packages/tree/main/internal/coapp</packageSourceUrl>
    <description>Surfaced by the version-mismatch triage of prospecting/community-version-reference.csv. Community's own coapp package is stuck at 1.23.521 (published 2015-06-26) while the vendor is at 2.0.19. This internal package tracks the vendor's own GitHub releases (aclap-dev/vdhcoapp) directly. NOTE: Community's existing "coapp" package id is an unrelated, unmaintained package for CoApp.Tools.Powershell (coapp.org) -- not this software -- do not reuse its install logic.</description>
    <tags>internal aclap-video-downloadhelper</tags>
    <dependencies />
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
