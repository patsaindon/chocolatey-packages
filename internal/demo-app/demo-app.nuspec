<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>demo-app</id>
    <version>0.0.0</version>
    <title>Demo App</title>
    <authors>Acme</authors>
    <owners>IT Operations</owners>
    <projectUrl>https://acme.example.com</projectUrl>
    <packageSourceUrl>https://github.com/patsaindon/chocolatey-packages/tree/main/internal/demo-app</packageSourceUrl>
    <description>Third attempt for demo-app, after fixing two real bugs the previous two attempts surfaced: (1) missing source_url in the prompt for the paywalled type, causing a choco pack failure on empty projectUrl; (2) open_pull_request silently reusing a closed PR's stale URL instead of creating a fresh one. Real Nexus asset (demo-app-2.0.0.exe) is still in place.</description>
    <tags>internal acme</tags>
    <dependencies />
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
