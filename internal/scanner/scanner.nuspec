<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>scanner</id>
    <version>0.0.0</version>
    <title>Angry IP Scanner</title>
    <authors>angryziber (Anton Keks)</authors>
    <owners>IT Operations</owners>
    <projectUrl>https://angryip.org/download/</projectUrl>
    <packageSourceUrl>https://github.com/patsaindon/chocolatey-packages/tree/main/internal/scanner</packageSourceUrl>
    <description>Surfaced by version-mismatch triage of prospecting/community-version-reference.csv. Community's own scanner package was stuck at 2.13.0.20151227 (and, per get_community_package_tools during scaffolding, actually tracks unrelated software from steffengerlach.de -- not Angry IP Scanner at all). This AU-based package tracks the vendor's real release page directly.</description>
    <tags>internal angryziber-anton-keks</tags>
    <dependencies />
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
