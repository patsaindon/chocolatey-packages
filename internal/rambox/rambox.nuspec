<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>rambox</id>
    <version>0.0.0</version>
    <title>Rambox</title>
    <authors>Rambox</authors>
    <owners>IT Operations</owners>
    <projectUrl>https://rambox.app/download</projectUrl>
    <packageSourceUrl>https://github.com/patsaindon/chocolatey-packages/tree/main/internal/rambox</packageSourceUrl>
    <description>Surfaced by version-mismatch triage of prospecting/community-version-reference.csv. Community's own rambox package is stuck at 0.7.7 (2143 days stale). Vendor's real current release (per evergreen-api) is 2.7.1, tracking the newer proprietary rambox.app build. The obvious GitHub source (github.com/ramboxapp/community-edition) is archived/read-only since April 2022, capped at v0.8.0 and points users to rambox.app instead -- so rambox.app/download is used as source_url instead of the dead GitHub repo.</description>
    <tags>internal</tags>
    <dependencies />
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
