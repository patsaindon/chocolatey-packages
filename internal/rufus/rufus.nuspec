<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>rufus</id>
    <version>0.0.0</version>
    <title>Akeo Rufus</title>
    <authors>Akeo Rufus</authors>
    <owners>IT Operations</owners>
    <projectUrl>https://rufus.ie/</projectUrl>
    <packageSourceUrl>https://github.com/patsaindon/chocolatey-packages/tree/main/internal/rufus</packageSourceUrl>
    <description>Rufus is a free, portable utility for creating bootable USB drives -- formatting and writing ISO images (Windows installers, Linux distros, UEFI/BIOS boot utilities) without installing anything.</description>
    <tags>internal akeo-rufus</tags>
    <dependencies />
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
