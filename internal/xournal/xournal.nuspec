<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>xournal</id>
    <version>0.0.0</version>
    <title>Xournal++</title>
    <authors>Xournal++ contributors</authors>
    <owners>IT Operations</owners>
    <projectUrl>https://github.com/xournalpp/xournalpp/releases</projectUrl>
    <packageSourceUrl>https://github.com/patsaindon/chocolatey-packages/tree/main/internal/xournal</packageSourceUrl>
    <description>Surfaced by the version-mismatch triage of prospecting/community-version-reference.csv. Community's own xournal package is stuck at 0.4.8 (published 2017-10-13) while the vendor's real successor project (Xournal++, not the original abandoned Xournal) is at 1.3.7.</description>
    <tags>internal xournal-contributors</tags>
    <dependencies />
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
